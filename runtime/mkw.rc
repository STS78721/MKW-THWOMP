/* Mario Kart World PC: the application manifest (mkw.manifest), the icon (mkw.ico) and the version block Windows shows
   in the file's Properties. tools/build_game.py compiles it with the runtime objects. */
#include <winver.h>
1 24 "mkw.manifest"
1 ICON "mkw.ico"
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Mario Kart World PC"
            VALUE "ProductName", "Mario Kart World PC"
            VALUE "InternalName", "mkw"
            VALUE "OriginalFilename", "mkw.exe"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
