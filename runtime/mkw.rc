/* Mario Kart World PC: application manifest (mkw.manifest), icon (mkw.ico), and the version block Windows shows
   in Properties. tools/build_game.py compiles this with the runtime objects. */
#include <winver.h>
1 24 "mkw.manifest"
1 ICON "mkw.ico"
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Mario Kart World"
            VALUE "FileDescription", "Mario Kart World"
            VALUE "ProductName", "Mario Kart World"
            VALUE "InternalName", "mkw"
            VALUE "OriginalFilename", "mkw.exe"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END


