/* The application manifest of mkw.exe (mkw.manifest): UTF-8 process code page, and its icon (mkw.ico, drawn by
   tools/build/icon.py into the object directory: a checkered flag of our own, no art of the game). tools/build/build.py
   --target windows compiles it with the runtime objects (as totk-pc-recomp's totk.rc, with an icon of our own). */
1 ICON "mkw.ico"
1 24 "mkw.manifest"
/* THWOMP: the name Windows shows in the file's Properties, the taskbar and Task Manager */
#include <winver.h>
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Mario Kart World PC"
            VALUE "FileDescription", "Mario Kart World"
            VALUE "ProductName", "Mario Kart World"
            VALUE "InternalName", "mkw"
            VALUE "OriginalFilename", "mkw.exe"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
