#version 450
// THWOMP DLSS compose: encode DLSS linear -> sRGB present; with DLSS-G, split HUD-less + premultiplied UI.
// UI must never remain inside HUD-less (that made Streamline warp Multiplayer text with scene MVs).
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D dlss;
layout(binding = 1) uniform sampler2D final_pic;
layout(binding = 2, rgba8) uniform writeonly image2D dst;
layout(binding = 3) uniform sampler2D bias;
layout(binding = 4) uniform sampler2D hudless_in;   // pre-tonemap scene without UI
layout(binding = 5) uniform sampler2D in_cur;       // linear Scene+UI
layout(binding = 6, rgba8) uniform writeonly image2D dst_hudless;
layout(binding = 7, rgba8) uniform writeonly image2D dst_ui;
layout(push_constant) uniform P {
    vec4 crop;
    vec2 tex;
    vec2 size;
    float view;
    float write_fg;
} pc;

vec3 enc(vec3 c) {
    c = max(c, vec3(0.0));
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, c));
}

vec3 approx_tm(vec3 c) {
    c = max(c, vec3(0.0));
    return c / (c + vec3(1.0));
}

vec4 cubic_weights(float f) {
    float f2 = f * f, f3 = f2 * f;
    return vec4(
        -0.5 * f + f2 - 0.5 * f3,
        1.0 - 2.5 * f2 + 1.5 * f3,
        0.5 * f + 2.0 * f2 - 1.5 * f3,
        -0.5 * f2 + 0.5 * f3
    );
}

vec3 sample_hudless_srgb(ivec2 rsize, vec2 uv) {
    vec2 t = uv * vec2(rsize) - 0.5;
    ivec2 i0 = ivec2(floor(t));
    vec2 f = clamp(t - vec2(i0), 0.0, 1.0);
    vec4 wx = cubic_weights(f.x);
    vec4 wy = cubic_weights(f.y);
    vec3 col = vec3(0.0);
    ivec2 max_p = rsize - 1;
    for (int dy = -1; dy <= 2; dy++) {
        vec3 row = vec3(0.0);
        int py = clamp(i0.y + dy, 0, max_p.y);
        for (int dx = -1; dx <= 2; dx++) {
            int px = clamp(i0.x + dx, 0, max_p.x);
            vec3 s = clamp(enc(approx_tm(texelFetch(hudless_in, ivec2(px, py), 0).rgb)), 0.0, 1.0);
            row += s * wx[dx + 1];
        }
        col += row * wy[dy + 1];
    }
    return clamp(col, 0.0, 1.0);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, ivec2(pc.size)))) return;
    vec2 uv = (vec2(p) + 0.5) / pc.size;
    vec3 F = clamp(enc(texture(dlss, uv).rgb), 0.0, 1.0);
    // Host-side history reject: Transformer presets ignore BiasCurrentColorHint. Where our reactive mask is high
    // (soft shadows, thin edges, HUD), lerp to the current game picture so trails cannot survive compose.
    float b = texture(bias, uv).r;
    vec2 src_uv = (pc.crop.xy + uv * pc.crop.zw) / pc.tex;
    vec3 cur = texture(final_pic, src_uv).rgb;
    // Reject only hard mask hits so a speckled bias does not bilinear the whole frame.
    float reject = smoothstep(0.55, 0.85, b);
    vec3 o = mix(F, cur, reject);
    // MKW_DLSS_MASK: 1 = split DLSS|source, 2 = tint reactive mask red, 3 = show source only (ghosts in cur?).
    if (pc.view > 2.5) o = cur;
    else if (pc.view > 1.5) o = mix(o, vec3(1.0, 0.0, 0.0), 0.75 * b);
    else if (pc.view > 0.5 && uv.x >= 0.5) o = cur;
    imageStore(dst, p, vec4(clamp(o, 0.0, 1.0), 1.0));

    if (pc.write_fg > 0.5) {
        ivec2 rsize = textureSize(in_cur, 0);
        vec3 H_bg = sample_hudless_srgb(rsize, uv);
        vec3 diff_bg = abs(F - H_bg);
        float d_bg = max(diff_bg.r, max(diff_bg.g, diff_bg.b));
        // Hard UI from finished-vs-scene gap only. Do not promote raw bias→UI: bias also marks soft shadows /
        // thin edges for ParticleHint, and flooding UI broke FG (and left shadow ghosts in the warped layer).
        float ui_w = clamp(smoothstep(0.02, 0.09, d_bg), 0.0, 1.0);
        if (d_bg > 0.07) ui_w = 1.0;
        // Bias reinforces UI where the gap already looks like an overlay (title logo, Free Roam icons).
        if (b > 0.4 && d_bg > 0.025) ui_w = max(ui_w, 0.95);

        vec3 H = mix(F, H_bg, ui_w);
        vec4 U = vec4(0.0);
        if (ui_w > 0.02) {
            float ax = 0.0;
            for (int k = 0; k < 3; k++) {
                float req = F[k] < H_bg[k] ? (H_bg[k] - F[k]) / max(H_bg[k], 1e-4)
                                           : (F[k] - H_bg[k]) / max(1.0 - H_bg[k], 1e-4);
                ax = max(ax, req);
            }
            float alpha = clamp(max(ax, ui_w), 0.0, 1.0);
            // Menu panels / text: force full UI layer so FG never warps them.
            if (ui_w >= 0.95) alpha = max(alpha, 0.92);
            if (alpha > 0.002) {
                H = mix(F, H_bg, alpha);
                U = vec4(clamp(F - (1.0 - alpha) * H, vec3(0.0), vec3(alpha)), alpha);
            }
        }
        // Reactive shadows for FG: high bias on ground (soft shadow) stays in current game frame's colour —
        // put a non-warped overlay so interpolated frames do not drag old shadow blocks.
        if (b > 0.4 && ui_w < 0.5) {
            float sa = smoothstep(0.4, 0.85, b);
            // Keep H as scene-ish; add current F as a short-lived overlay (shadow update).
            vec3 Hs = mix(H, H_bg, sa * 0.65);
            float ax = 0.0;
            for (int k = 0; k < 3; k++) {
                float req = F[k] < Hs[k] ? (Hs[k] - F[k]) / max(Hs[k], 1e-4)
                                         : (F[k] - Hs[k]) / max(1.0 - Hs[k], 1e-4);
                ax = max(ax, req);
            }
            float alpha = clamp(ax * sa, 0.0, 1.0);
            if (alpha > U.a) {
                H = Hs;
                U = vec4(clamp(F - (1.0 - alpha) * H, vec3(0.0), vec3(alpha)), alpha);
            }
        }
        imageStore(dst_hudless, p, vec4(clamp(H, 0.0, 1.0), 1.0));
        imageStore(dst_ui, p, U);
    }
}
