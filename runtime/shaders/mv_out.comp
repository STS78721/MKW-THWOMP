#version 450
// THWOMP MVs + reactive hint. Transformer presets ignore BiasCurrentColorHint; Particle/AnimatedTexture + a
// compose-time lerp to the current frame kill soft-shadow / thin-edge / HUD trails. Keep the mask sparse —
// flooding it replaces the whole DLSS picture with bilinear.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D depth;
layout(binding = 1) uniform sampler2D vel;
layout(binding = 2, rg16f) uniform writeonly image2D mv_out;
layout(binding = 3) uniform sampler2D cur_pic;
layout(binding = 4) uniform sampler2D prev_pic;
layout(binding = 5, r16f) uniform writeonly image2D bias_out;
layout(binding = 6) uniform sampler2D cur_scene;
layout(binding = 7) uniform sampler2D prev_scene;
layout(push_constant) uniform P {
    mat4 m;
    vec2 size;
    vec2 jd;
    float has_prev;
    float has_scene;
    float has_vel;
    float _pad;
    ivec4 rect;
} pc;

float tone(vec3 c) { return sqrt(max(dot(c, vec3(0.2126, 0.7152, 0.0722)), 0.0)); }
vec3 approx_tm(vec3 c) {
    c = max(c, vec3(0.0));
    return c / (c + vec3(1.0));
}
float tone_scene(vec3 c) { return tone(approx_tm(c)); }

vec2 cam_mv(ivec2 px, float d) {
    vec2 tile_sz = vec2(pc.rect.zw);
    vec2 luv = (vec2(px - pc.rect.xy) + 0.5) / tile_sz;
    vec4 q = pc.m * vec4(luv.x * 2.0 - 1.0, 1.0 - luv.y * 2.0, d * 2.0 - 1.0, 1.0);
    vec2 pn = q.xy / q.w;
    vec2 pluv = vec2(pn.x * 0.5 + 0.5, 0.5 - pn.y * 0.5);
    return (pluv - luv) * tile_sz;
}

vec2 pixel_mv(ivec2 p, vec2 uv) {
    if (pc.has_vel > 0.5) {
        vec4 ov = texelFetch(vel, p, 0);
        if (ov.a > 0.5) return -(ov.xy - pc.jd);
    }
    return cam_mv(p, texture(depth, uv).r);
}

void main() {
    ivec2 lp = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(lp, pc.rect.zw))) return;
    ivec2 p = pc.rect.xy + lp;
    if (any(greaterThanEqual(p, ivec2(pc.size)))) return;
    vec2 uv = (vec2(p) + 0.5) / pc.size;
    vec4 ov = pc.has_vel > 0.5 ? texelFetch(vel, p, 0) : vec4(0.0);
    bool cam = ov.a <= 0.5;
    float d0 = texture(depth, uv).r;
    vec2 mv = cam ? cam_mv(p, d0) : -(ov.xy - pc.jd);

    // Dilate MVs toward closer depth (lamp poles / thin silhouettes), clamped inside this viewport tile.
    ivec2 min_p = pc.rect.xy;
    ivec2 max_p = min(pc.rect.xy + pc.rect.zw, ivec2(pc.size)) - 1;
    float best_d = d0;
    vec2 best_mv = mv;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            if (dx == 0 && dy == 0) continue;
            ivec2 q = clamp(p + ivec2(dx, dy), min_p, max_p);
            vec2 quv = (vec2(q) + 0.5) / pc.size;
            float dq = texture(depth, quv).r;
            if (dq + 0.003 < best_d) {
                best_d = dq;
                best_mv = pixel_mv(q, quv);
            }
        }
    }
    mv = best_mv;

    vec2 prev_uv = uv + (mv - pc.jd) / pc.size;
    vec2 rect_lo = vec2(pc.rect.xy) / pc.size;
    vec2 rect_hi = vec2(pc.rect.xy + pc.rect.zw) / pc.size;
    bool prev_ok = pc.has_prev > 0.5 && all(greaterThanEqual(prev_uv, rect_lo)) && all(lessThanEqual(prev_uv, rect_hi));
    float bias = 0.0;

    if (pc.has_prev > 0.5 && !prev_ok) {
        bias = 1.0;
    } else if (prev_ok) {
        float ct = tone(texelFetch(cur_pic, p, 0).rgb);
        float pt = tone(texture(prev_pic, prev_uv).rgb);
        float diff = abs(ct - pt);

        // Soft contact shadows: camera pixel, clearly darker than reprojected previous, and not already bright.
        // Strict thresholds — temporal noise on sand/snow must not paint the whole ground.
        float shadow = 0.0;
        if (cam) {
            float c_luma, p_luma;
            if (pc.has_scene > 0.5) {
                c_luma = tone_scene(texelFetch(cur_scene, p, 0).rgb);
                p_luma = tone_scene(texture(prev_scene, prev_uv).rgb);
            } else {
                c_luma = ct;
                p_luma = pt;
            }
            float darken = max(0.0, p_luma - c_luma);
            // Binary contact-shadow hit only — soft smoothsteps speckled the whole track.
            if (darken > 0.10 && c_luma < 0.42) shadow = 1.0;

            // Dilate hard hits only (Performance block ghosts), keep binary.
            if (shadow > 0.5) {
                for (int dy = -2; dy <= 2; dy++) {
                    for (int dx = -2; dx <= 2; dx++) {
                        ivec2 q = clamp(p + ivec2(dx, dy), min_p, max_p);
                        vec2 puv = clamp(prev_uv + vec2(dx, dy) / pc.size, rect_lo, rect_hi);
                        float cq, pq;
                        if (pc.has_scene > 0.5) {
                            cq = tone_scene(texelFetch(cur_scene, q, 0).rgb);
                            pq = tone_scene(texture(prev_scene, puv).rgb);
                        } else {
                            cq = tone(texelFetch(cur_pic, q, 0).rgb);
                            pq = tone(texture(prev_pic, puv).rgb);
                        }
                        float dk = max(0.0, pq - cq);
                        if (dk > 0.09 && cq < 0.42) shadow = 1.0;
                    }
                }
            }
        }

        // Thin silhouettes against sky: hard depth edge + strong contrast only (lamps/poles).
        float thin = 0.0;
        float edge = 0.0;
        float far_nb = 0.0;
        for (int dy = -1; dy <= 1; dy++) {
            for (int dx = -1; dx <= 1; dx++) {
                if (dx == 0 && dy == 0) continue;
                ivec2 q = clamp(p + ivec2(dx, dy), min_p, max_p);
                float dq = texture(depth, (vec2(q) + 0.5) / pc.size).r;
                edge = max(edge, abs(dq - d0));
                far_nb = max(far_nb, dq);
            }
        }
        if (edge > 0.10 && (far_nb - d0) > 0.08) {
            float contrast = 0.0;
            for (int dy = -1; dy <= 1; dy++) {
                for (int dx = -1; dx <= 1; dx++) {
                    ivec2 q = clamp(p + ivec2(dx, dy), min_p, max_p);
                    contrast = max(contrast, abs(tone(texelFetch(cur_pic, q, 0).rgb) - ct));
                }
            }
            if (contrast > 0.16) thin = 1.0;
        }

        if (cam) {
            bias = max(shadow, thin);
            // Split-screen without XFB object velocity: flag moving objects (karts) whose camera-reprojected
            // previous pixel disagrees strongly so DLSS/DLSS-G do not warp them with road MVs.
            if (pc.has_vel < 0.5 && diff > 0.14) bias = 1.0;
        } else if (diff > 0.08) {
            bias = 1.0;
        }

        // HUD / title logo: finished must disagree with HUD-less scene (content gap).
        if (pc.has_scene > 0.5) {
            float sc = tone_scene(texelFetch(cur_scene, p, 0).rgb);
            float ui_gap = abs(ct - sc) / (max(ct, sc) + 0.08);
            // Semi-transparent Free Roam / character-select panels need a lower gate than opaque logos.
            if (ui_gap > 0.10) bias = 1.0;
        } else if (diff > 0.025) {
            // No HUD-less this frame (many game menus): fall back to finished temporal reject so icons do not trail.
            bias = 1.0;
        }
    }

    // Hard reactive hits: kill history fetch by zeroing MVs (disocclusion) in addition to ParticleHint / compose reject.
    if (bias > 0.5) mv = vec2(0.0);
    imageStore(mv_out, p, vec4(mv, 0.0, 0.0));
    imageStore(bias_out, p, vec4(clamp(bias, 0.0, 1.0)));
}
